# Hostinger / Apache Clean URLs (.htaccess)
# Removes .html extension from URLs automatically

# ─── Security headers ─────────────────────────────────────────────────────────
<IfModule mod_headers.c>
  # Stop the site being framed into a look-alike payment page (clickjacking).
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=(self)"
  # HSTS: only meaningful once the site is fully on HTTPS.
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"

  # Never let an intermediary cache an authenticated page.
  <FilesMatch "^(admin|admin-reels)\.html$">
    Header always set Cache-Control "no-store, no-cache, must-revalidate, private"
    Header always set X-Robots-Tag "noindex, nofollow"
  </FilesMatch>
</IfModule>

# Block direct access to server-side and config files if they ever get uploaded.
<FilesMatch "\.(sql|env|py|md|log)$">
  Require all denied
</FilesMatch>

RewriteEngine On

# 1. Redirect external requests with .html extension to clean extensionless URLs (301 Permanent Redirect)
RewriteCond %{THE_REQUEST} \s/+(.+?)\.html[\s?] [NC]
RewriteRule ^ /%1 [R=301,L]

# 2. Internally serve .html file when an extensionless URL is requested
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}\.html -f
RewriteRule ^(.*)$ $1.html [L]
