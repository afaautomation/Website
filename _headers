# Cloudflare Pages response headers (replaces the Apache .htaccess rules).
/*
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=(self)
  Strict-Transport-Security: max-age=31536000; includeSubDomains

# Never cache or index the staff consoles (HR and Marketing).
/admin*
  Cache-Control: no-store, no-cache, must-revalidate, private
  X-Robots-Tag: noindex, nofollow
/marketing*
  Cache-Control: no-store, no-cache, must-revalidate, private
  X-Robots-Tag: noindex, nofollow

# Images, video and the syllabus PDF rarely change; let browsers keep them for 30 days.
# To replace a picture, save it under a NEW filename (e.g. add -v2) and update the page;
# overwriting a file keeps showing the old picture to returning visitors for up to 30 days.
/*.webp
  Cache-Control: public, max-age=2592000
/*.jpg
  Cache-Control: public, max-age=2592000
/*.png
  Cache-Control: public, max-age=2592000
/*.ico
  Cache-Control: public, max-age=2592000
/*.mp4
  Cache-Control: public, max-age=2592000
/*.pdf
  Cache-Control: public, max-age=2592000
/*.svg
  Cache-Control: public, max-age=2592000

# The staff console's local AI model and runtime (about 36 MB) are pinned versions; keep them 30 days.
/js/models/*
  Cache-Control: public, max-age=2592000
/js/vendor/*
  Cache-Control: public, max-age=2592000

# Keep the consultation page out of search results on the staging domain until launch.
https://kompetenzen.pages.dev/career-consultation*
  X-Robots-Tag: noindex
https://kompetenzen.pages.dev/finishing-school*
  X-Robots-Tag: noindex
